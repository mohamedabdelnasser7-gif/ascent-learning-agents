# Copy to .env and fill in. Never commit .env.

# Baseten, the model behind the front desk
BASETEN_API_KEY=
# Default is meta-models/muse-spark-open-1026 (worked in our 27 Oct tests).
# The Baseten changelog names it meta-models/muse-spark-open.
BASETEN_MODEL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Default v26.0 (Graph API changelog, checked 28 Oct 2026)
GRAPH_API_VERSION=
# Required: the team member who takes over handed-off chats, digits only with country code.
# The server does not start without it.
OPERATOR_WHATSAPP=

# Shopify Admin API. Leave empty to use demo/catalogue.json
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=

# Model call limits. Per customer: LIMIT_CUSTOMER_CALLS calls in LIMIT_CUSTOMER_SECONDS,
# and LIMIT_CUSTOMER_DAILY calls in the last 24 hours.
# Overall: LIMIT_DAILY_CALLS calls in the last 24 hours. These are the defaults.
LIMIT_CUSTOMER_CALLS=20
LIMIT_CUSTOMER_SECONDS=600
LIMIT_CUSTOMER_DAILY=150
LIMIT_DAILY_CALLS=1000

# Local server
PORT=8080
# Optional: path to ffmpeg for voice notes
FFMPEG=
