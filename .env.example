# Copy to .env and fill in. Never commit .env.

# Baseten, the model behind the front desk
BASETEN_API_KEY=
# Default is meta-models/muse-spark-open-1026 (worked in our 27 Oct tests).
# The Baseten changelog names it meta-models/muse-spark-open.
BASETEN_MODEL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Default v26.0 (Graph API changelog, checked 28 Oct 2026)
GRAPH_API_VERSION=
# The team member who takes over handed-off chats, digits only with country code
OPERATOR_WHATSAPP=

# Shopify Admin API. Leave empty to use demo/catalogue.json
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=

# Local server
PORT=8080
# Optional: path to ffmpeg for voice notes
FFMPEG=
